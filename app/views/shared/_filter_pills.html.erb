<%# locals: model, clear_path, colspan, value_labels: {} %>
<% active_filters = model.active_filters_from(params[:f]) %>
<% value_labels ||= {} %>
<% if active_filters.any? %>
  <tr>
    <td colspan="<%= colspan %>" class="px-3 py-1.5 bg-blue-50 dark:bg-blue-900/20 border-b border-gray-200 dark:border-gray-800">
      <div class="flex items-center gap-1.5 flex-wrap text-xs normal-case tracking-normal font-normal">
        <span class="text-gray-500 dark:text-gray-400">Filters:</span>
        <% active_filters.each do |f| %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
            <span><%= f[:label] %> <%= filter_op_label(f[:op]) %> <%= filter_value_label(f, value_labels[f[:key]]) %></span>
            <a href="<%= url_for_removing_filter(f[:key], f[:op]) %>" class="hover:text-blue-900 dark:hover:text-blue-100">✕</a>
          </span>
        <% end %>
        <a href="<%= clear_path %>?clear=1" class="text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 underline ml-1">Clear all</a>
      </div>
    </td>
  </tr>
<% end %>

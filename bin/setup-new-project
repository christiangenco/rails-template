#!/usr/bin/env ruby
# frozen_string_literal: true

# Setup script for creating a new project from the rails-template.
# Regenerates master.key, carries forward shared secrets, and replaces
# all template placeholders with project-specific values.
#
# Usage:
#   bin/setup-new-project --name myapp --domain myapp.com --server-ip 123.45.67.89
#
# Options:
#   --name        App name (lowercase, e.g. widgetco). Used for service, image,
#                 storage volume, Litestream path, etc.
#   --domain      Production domain (default: NAME.com)
#   --server-ip   Production server IP address
#   --github-user GitHub username for GHCR (default: christiangenco)
#   --s3-bucket   Litestream backup bucket (default: genco-backups)
#   --help        Show this help message

require "yaml"
require "json"
require "fileutils"
require "optparse"

options = {
  github_user: "christiangenco",
  s3_bucket: "genco-backups"
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/setup-new-project [options]"

  opts.on("--name NAME", "App name (lowercase, e.g. widgetco)") { |v| options[:name] = v }
  opts.on("--domain DOMAIN", "Production domain (default: NAME.com)") { |v| options[:domain] = v }
  opts.on("--server-ip IP", "Production server IP address") { |v| options[:server_ip] = v }
  opts.on("--github-user USER", "GitHub username for GHCR (default: christiangenco)") { |v| options[:github_user] = v }
  opts.on("--s3-bucket BUCKET", "Litestream backup bucket (default: genco-backups)") { |v| options[:s3_bucket] = v }
  opts.on("-h", "--help", "Show this help message") do
    puts opts
    exit
  end
end

parser.parse!

unless options[:name]
  puts parser
  abort "\nError: --name is required"
end

unless options[:server_ip]
  puts parser
  abort "\nError: --server-ip is required"
end

options[:domain] ||= "#{options[:name]}.com"

app_name = options[:name]
domain = options[:domain]
server_ip = options[:server_ip]
github_user = options[:github_user]
s3_bucket = options[:s3_bucket]

def run(cmd)
  output = `#{cmd} 2>&1`
  abort "Command failed: #{cmd}\n#{output}" unless $?.success?
  output.strip
end

def replace_in_file(path, replacements)
  return unless File.exist?(path)
  content = File.read(path)
  replacements.each { |find, replace| content.gsub!(find, replace) }
  File.write(path, content)
end

puts "Setting up new project:"
puts "  App name:    #{app_name}"
puts "  Domain:      #{domain}"
puts "  Server IP:   #{server_ip}"
puts "  GHCR image:  ghcr.io/#{github_user}/#{app_name}"
puts "  Backups:     s3://#{s3_bucket}/#{app_name}/production.sqlite3"
puts

# Step 1: Read shared secrets from current credentials
puts "Reading shared secrets from current credentials..."
secrets_json = run('bin/rails runner "
  creds = Rails.application.credentials
  secrets = {
    ghcr_token: creds.dig(:ghcr, :token),
    litestream_access_key_id: creds.dig(:litestream, :access_key_id),
    litestream_secret_access_key: creds.dig(:litestream, :secret_access_key)
  }
  puts secrets.to_json
"')
secrets = JSON.parse(secrets_json)

missing = secrets.select { |_k, v| v.nil? || v.to_s.empty? }
unless missing.empty?
  puts "WARNING: Missing credentials: #{missing.keys.join(', ')}"
  puts "You'll need to add these manually with: bin/rails credentials:edit"
end

# Step 2: Regenerate master key and credentials
puts "Regenerating master key and credentials..."
FileUtils.rm_f("config/master.key")
FileUtils.rm_f("config/credentials.yml.enc")

creds_yaml = {
  "ghcr" => { "token" => secrets["ghcr_token"] },
  "litestream" => {
    "access_key_id" => secrets["litestream_access_key_id"],
    "secret_access_key" => secrets["litestream_secret_access_key"]
  }
}.to_yaml

tmpfile = File.expand_path("tmp/new_credentials.yml")
File.write(tmpfile, creds_yaml)
run("EDITOR='cp #{tmpfile}' bin/rails credentials:edit")
FileUtils.rm_f(tmpfile)

new_master_key = File.read("config/master.key").strip
puts "  New master key: #{new_master_key[0..3]}#{'*' * (new_master_key.length - 4)}"

# Step 3: Replace placeholders in deploy.yml
puts "Updating config/deploy.yml..."
replace_in_file("config/deploy.yml", {
  "service: myapp" => "service: #{app_name}",
  "image: YOUR_GITHUB_USERNAME/myapp" => "image: #{github_user}/#{app_name}",
  "YOUR_SERVER_IP" => server_ip,
  "YOUR_GITHUB_USERNAME" => github_user,
  "myapp.com" => domain,
  "myapp_storage" => "#{app_name}_storage"
})

# Step 4: Update litestream.yml
puts "Updating config/litestream.yml..."
replace_in_file("config/litestream.yml", {
  "your-backups-bucket" => s3_bucket,
  "myapp/production.sqlite3" => "#{app_name}/production.sqlite3"
})

puts
puts "=" * 60
puts "  Setup complete!"
puts "=" * 60
puts
puts "Next steps:"
puts
puts "  1. Add GitHub repo secrets (for CI deploys):"
puts "     RAILS_MASTER_KEY=#{new_master_key}"
puts "     SSH_PRIVATE_KEY=(your deploy key)"
puts
puts "  2. Log into GHCR on the server:"
puts "     ssh root@#{server_ip} \"echo 'TOKEN' | docker login ghcr.io -u #{github_user} --password-stdin\""
puts "     (Get the token with: bin/rails runner \"puts Rails.application.credentials.dig(:ghcr, :token)\")"
puts
puts "  3. Point DNS for #{domain} to #{server_ip}"
puts
puts "  4. Deploy:"
puts "     bin/kamal setup    # First deploy"
puts "     bin/kamal deploy   # Subsequent deploys"
puts

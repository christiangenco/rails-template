#!/usr/bin/env ruby
# frozen_string_literal: true

# Setup script for creating a new project from the rails-template.
# Regenerates master.key and credentials with fresh values (nothing is copied
# from the template's credentials), and replaces all template placeholders
# with project-specific values. GHCR: .kamal/secrets uses `gh auth token`.
# Litestream: one bucket and one key per app. The template's Litestream and
# Spaces keys are never copied; make the app's own with
# ~/projects/hq/bin/ls-bucket-per-app provision NAME DIR.
#
# Usage:
#   bin/setup-new-project --name myapp --domain myapp.com --server-ip 123.45.67.89
#
# Options:
#   --name           App name (lowercase, e.g. widgetco). Used for service, image,
#                    storage volume, Litestream path, etc.
#   --domain         Production domain (default: NAME.com)
#   --server-ip      Production server IP address
#   --image-owner    GHCR image owner: ghcr.io/OWNER/NAME (default: gxbvc)
#   --github-user    GitHub user for the GHCR registry login (default: christiangenco)
#   --s3-bucket      Litestream backup bucket (default: gxb-ls-NAME; the shared
#                    genco-backups bucket is refused)
#   --smtp-user      SMTP username for Mailgun (default: NAME@gxb.vc)
#   --create-smtp    Make a random 32-character SMTP password and create the
#                    Mailgun SMTP login for it (recommended). The password goes
#                    only into credentials; it is never printed. Mailgun API key
#                    from MAILGUN_API_KEY_FILE (default ~/tools/mailgun-cli/.env).
#   --smtp-password-file PATH  Read the SMTP password from a mode-600 file
#   --smtp-password  SMTP password for Mailgun (or set MAILGUN_SMTP_PASSWORD);
#                    lands in shell history, prefer --create-smtp
#   --mail-from      Default mailer "from" address (default: noreply@gxb.vc)
#   --no-mail        Skip mail setup for now; mail raises clearly on first use
#                    instead of failing SMTP auth silently. Required unless
#                    --smtp-password/MAILGUN_SMTP_PASSWORD is given.
#   --help           Show this help message

require "yaml"
require "fileutils"
require "optparse"
require "securerandom"
require_relative "../lib/setup_new_project"

MAILGUN_DOMAIN = "gxb.vc"

options = {
  github_user: SetupNewProject::REGISTRY_USER,
  image_owner: SetupNewProject::IMAGE_OWNER
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/setup-new-project [options]"

  opts.on("--name NAME", "App name (lowercase, e.g. widgetco)") { |v| options[:name] = v }
  opts.on("--domain DOMAIN", "Production domain (default: NAME.com)") { |v| options[:domain] = v }
  opts.on("--server-ip IP", "Production server IP address") { |v| options[:server_ip] = v }
  opts.on("--image-owner OWNER", "GHCR image owner (default: #{SetupNewProject::IMAGE_OWNER})") { |v| options[:image_owner] = v }
  opts.on("--github-user USER", "GitHub user for the GHCR registry login (default: #{SetupNewProject::REGISTRY_USER})") { |v| options[:github_user] = v }
  opts.on("--s3-bucket BUCKET", "Litestream backup bucket (default: gxb-ls-NAME)") { |v| options[:s3_bucket] = v }
  opts.on("--smtp-user USER", "SMTP username for Mailgun (default: NAME@#{MAILGUN_DOMAIN})") { |v| options[:smtp_user] = v }
  opts.on("--smtp-password PASS", "SMTP password for Mailgun (or set MAILGUN_SMTP_PASSWORD)") { |v| options[:smtp_password] = v }
  opts.on("--smtp-password-file PATH", "Read the SMTP password from a mode-600 file") { |v| options[:smtp_password_file] = v }
  opts.on("--create-smtp", "Make a random SMTP password and create the Mailgun login (recommended)") { options[:create_smtp] = true }
  opts.on("--mail-from FROM", "Default mailer from address (default: noreply@#{MAILGUN_DOMAIN})") { |v| options[:mail_from] = v }
  opts.on("--no-mail", "Skip mail setup for now (mail raises clearly on first use instead of failing SMTP auth silently)") { options[:no_mail] = true }
  opts.on("-h", "--help", "Show this help message") do
    puts opts
    exit
  end
end

parser.parse!

unless options[:name]
  puts parser
  abort "\nError: --name is required"
end

unless options[:server_ip]
  puts parser
  abort "\nError: --server-ip is required"
end

options[:domain] ||= "#{options[:name]}.com"
options[:s3_bucket] ||= SetupNewProject.default_s3_bucket(options[:name])
begin
  SetupNewProject.check_s3_bucket!(options[:s3_bucket])
rescue ArgumentError => e
  abort "Error: #{e.message}"
end

app_name = options[:name]
domain = options[:domain]
server_ip = options[:server_ip]
github_user = options[:github_user]
image_owner = options[:image_owner]
s3_bucket = options[:s3_bucket]
no_mail = options[:no_mail]
smtp_password = options[:smtp_password] || ENV["MAILGUN_SMTP_PASSWORD"]
if (pw_file = options[:smtp_password_file])
  abort "Error: #{pw_file} must be mode 600" unless (File.stat(pw_file).mode & 0o777) == 0o600
  smtp_password = File.read(pw_file).strip
end
smtp_password = SecureRandom.alphanumeric(32) if options[:create_smtp]

if !no_mail && smtp_password.to_s.empty?
  puts parser
  abort "\nError: --create-smtp (or --smtp-password-file, --smtp-password, MAILGUN_SMTP_PASSWORD) is required, " \
        "or pass --no-mail to skip mail setup for now."
end

# A short or example password is guessable: the AGENTS.md example was once used as a real password (Oct 2026).
if smtp_password && smtp_password.length < 24
  abort "Error: the SMTP password must be at least 24 characters. Use --create-smtp for a random one."
end

smtp_user = options[:smtp_user] || (smtp_password ? "#{app_name}@#{MAILGUN_DOMAIN}" : nil)

# --create-smtp: read the Mailgun API key now (fail before anything is written). The login itself
# is created only after the credentials are saved (Step 2).
if options[:create_smtp]
  key_file = File.expand_path(ENV.fetch("MAILGUN_API_KEY_FILE", "~/tools/mailgun-cli/.env"))
  abort "Error: no Mailgun API key file at #{key_file} (set MAILGUN_API_KEY_FILE)" unless File.readable?(key_file)
  mailgun_api_key = SetupNewProject.mailgun_api_key(key_file)
end
mail_from = options[:mail_from] || "noreply@#{MAILGUN_DOMAIN}"

def run(cmd)
  output = `#{cmd} 2>&1`
  abort "Command failed: #{cmd}\n#{output}" unless $?.success?
  output.strip
end

def replace_in_file(path, replacements)
  return unless File.exist?(path)
  content = File.read(path)
  replacements.each { |find, replace| content.gsub!(find, replace) }
  File.write(path, content)
end

puts "Setting up new project:"
puts "  App name:    #{app_name}"
puts "  Domain:      #{domain}"
puts "  Server IP:   #{server_ip}"
puts "  GHCR image:  ghcr.io/#{image_owner}/#{app_name} (registry login: #{github_user})"
puts "  Backups:     s3://#{s3_bucket}/#{app_name}/production.sqlite3"
if smtp_user
  puts "  SMTP user:   #{smtp_user}"
  puts "  Mail from:   #{mail_from}"
end
puts

# Step 1 (reading secrets from the template's credentials) was removed: nothing is copied.
# Step 2: Regenerate master key and credentials (fresh values only)
puts "Regenerating master key and credentials..."
FileUtils.rm_f("config/master.key")
FileUtils.rm_f("config/credentials.yml.enc")

creds_hash = SetupNewProject.credentials_hash(smtp_password: smtp_password)

creds_yaml = creds_hash.to_yaml

tmpfile = File.expand_path("tmp/new_credentials.yml")
write_credentials = lambda do
  # Plaintext, so mode 600 and always deleted, even when credentials:edit fails.
  FileUtils.rm_f(tmpfile) # perm: only applies to a new file; a stale one would keep its old mode
  File.write(tmpfile, creds_yaml, perm: 0o600)
  run("EDITOR='cp #{tmpfile}' bin/rails credentials:edit")
ensure
  FileUtils.rm_f(tmpfile)
end
create_login = if options[:create_smtp]
  lambda do
    SetupNewProject.create_mailgun_login(login: smtp_user, password: smtp_password, api_key: mailgun_api_key)
    puts "  Mailgun SMTP login #{smtp_user} created (random 32-character password, stored only in credentials)"
  rescue StandardError => e
    detail = e.is_a?(SetupNewProject::MailgunError) ? e.message : "#{e.class}: #{e.message}"
    abort "Error: the Mailgun login #{smtp_user} was not created (#{detail}). The new credentials hold a " \
          "password that no login uses, so there is no live login to clean up. Fix the cause and run " \
          "bin/setup-new-project again (it makes new credentials)."
  end
end
SetupNewProject.write_credentials_then_create_login(write_credentials: write_credentials, create_login: create_login)

new_master_key = File.read("config/master.key").strip
puts "  New master key: #{new_master_key[0..3]}#{'*' * (new_master_key.length - 4)}"

# Step 3: Replace placeholders in deploy.yml
puts "Updating config/deploy.yml..."
replace_in_file("config/deploy.yml", SetupNewProject.deploy_yml_replacements(
  app_name: app_name, domain: domain, server_ip: server_ip,
  image_owner: image_owner, registry_user: github_user
))

# Step 4: Update litestream.yml
puts "Updating config/litestream.yml..."
replace_in_file("config/litestream.yml", {
  "your-backups-bucket" => s3_bucket,
  "myapp/production.sqlite3" => "#{app_name}/production.sqlite3"
})

# Step 5: Configure email (production mailer + default from address)
puts "Configuring email..."

prod_rb = "config/environments/production.rb"
if File.exist?(prod_rb)
  content = File.read(prod_rb)

  content.gsub!(
    'require_relative "../../app/lib/unconfigured_mail_delivery"',
    no_mail ? 'require_relative "../../app/lib/unconfigured_mail_delivery"' : 'require_relative "../../app/lib/mailgun_smtp_settings"'
  )

  mail_block = if no_mail
    <<~RUBY.chomp
      # Set host to be used by links generated in mailer templates.
      config.action_mailer.default_url_options = { host: "#{domain}" }

      # No Mailgun credentials yet (bin/setup-new-project ran with --no-mail).
      # Mail delivery raises a clear error the first time a mailer is used,
      # instead of failing SMTP auth silently. Re-run bin/setup-new-project
      # with --smtp-password (or set MAILGUN_SMTP_PASSWORD) to enable it.
      ActionMailer::Base.add_delivery_method :unconfigured, UnconfiguredMailDelivery
      config.action_mailer.delivery_method = :unconfigured
    RUBY
  else
    <<~RUBY.chomp
      # Set host to be used by links generated in mailer templates.
      config.action_mailer.default_url_options = { host: "#{domain}" }

      # Mailgun SMTP
      config.action_mailer.smtp_settings = MailgunSmtpSettings.for(user_name: "#{smtp_user}")
    RUBY
  end

  indented_mail_block = mail_block.lines.map { |line| line.strip.empty? ? line : "  #{line}" }.join

  content.gsub!(
    /  # Set host to be used by links generated in mailer templates\.\n  config\.action_mailer\.default_url_options = \{ host: "example\.com" \}\n\n  # No Mailgun credentials yet.*?config\.action_mailer\.delivery_method = :unconfigured/m,
    indented_mail_block
  )

  File.write(prod_rb, content)
end

# Update default mailer from address
mailer_rb = "app/mailers/application_mailer.rb"
if File.exist?(mailer_rb)
  replace_in_file(mailer_rb, {
    'default from: "from@example.com"' => "default from: \"#{mail_from}\""
  })
end

if no_mail
  puts "  Mail left unconfigured (--no-mail): it raises clearly the first time a mailer is used."
else
  puts "  SMTP user: #{smtp_user}"
  puts "  Mail from: #{mail_from}"
end

# Step 6: Sync Dockerfile Ruby version with .ruby-version
ruby_version = File.read(".ruby-version").strip
dockerfile = "Dockerfile"
if File.exist?(dockerfile)
  content = File.read(dockerfile, encoding: "UTF-8")
  content.gsub!(/ARG RUBY_VERSION=[\d.]+/, "ARG RUBY_VERSION=#{ruby_version}")
  File.write(dockerfile, content)
  puts "Synced Dockerfile Ruby version to #{ruby_version}"
end

# Step 7: Rename Rails module from RailsTemplate to the app's class name
class_name = app_name.split(/[_-]/).map(&:capitalize).join
app_rb = "config/application.rb"
if File.exist?(app_rb) && File.read(app_rb, encoding: "UTF-8").include?("module RailsTemplate")
  replace_in_file(app_rb, { "module RailsTemplate" => "module #{class_name}" })
  puts "Renamed Rails module to #{class_name} in #{app_rb}"
end

# Step 8: Update PWA manifest with app name
manifest = "app/views/pwa/manifest.json.erb"
if File.exist?(manifest)
  replace_in_file(manifest, {
    '"name": "RailsTemplate"' => %("name": "#{class_name}"),
    '"description": "RailsTemplate."' => %("description": "#{class_name}.")
  })
  puts "Updated PWA manifest with app name #{class_name}"
end

puts
puts "=" * 60
puts "  Setup complete!"
puts "=" * 60
puts
puts "Next steps:"
puts
puts "  1. Point DNS for #{domain} to #{server_ip}"
puts
puts "     Make the backup bucket #{s3_bucket} and its own key (writes them into credentials):"
puts "     ~/projects/hq/bin/ls-bucket-per-app provision #{app_name} #{Dir.pwd}"
puts
if no_mail
  puts "  2. Configure email sending when this app needs to send mail:"
  puts "     - Create Mailgun SMTP credentials for #{smtp_user || "#{app_name}@#{MAILGUN_DOMAIN}"}"
  puts "     - Re-run bin/setup-new-project with --smtp-password (or MAILGUN_SMTP_PASSWORD)"
  puts
end
puts "  #{smtp_user ? '2' : '3'}. Deploy:"
puts "     bundle exec kamal setup    # First deploy"
puts "     bundle exec kamal deploy   # Subsequent deploys"
puts
